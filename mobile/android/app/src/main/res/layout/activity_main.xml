<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
      2026-08-11: 単体動作版へ移行(PCのIPアドレス入力は不要になった)。
      内蔵サーバー起動中/失敗時の状態表示のみを残す(setup_panelという
      ID名は既存レイアウトから引き継ぎ、役割を「接続設定」から
      「起動状態表示」へ変更)。
    -->
    <LinearLayout
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/setup_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_help"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/update_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D6336C"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
